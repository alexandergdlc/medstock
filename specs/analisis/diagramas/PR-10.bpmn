<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P10_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P10_coll">
    <bpmn:participant id="P10_pool" name="PR-10 Auditoría" processRef="P10" />
  </bpmn:collaboration>
  <bpmn:process id="P10" isExecutable="false">
    <bpmn:laneSet id="P10_lanes">
      <bpmn:lane id="P10_lane0" name="Auditor">
        <bpmn:flowNodeRef>P10_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_lane1" name="MedStock">
        <bpmn:flowNodeRef>P10_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_en</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_lane2" name="Responsable de cadena" />
    </bpmn:laneSet>
    <bpmn:startEvent id="P10_start" name="Inicio">
      <bpmn:outgoing>P10_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P10_t1" name="Seleccionar ámbito y referencia">
      <bpmn:incoming>P10_f0</bpmn:incoming>
      <bpmn:outgoing>P10_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P10_t2" name="Conciliar movimientos y verificar enlaces">
      <bpmn:incoming>P10_f1</bpmn:incoming>
      <bpmn:outgoing>P10_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P10_gate" name="¿Evidencia íntegra y suficiente?">
      <bpmn:incoming>P10_f2</bpmn:incoming>
      <bpmn:outgoing>P10_f3</bpmn:outgoing>
      <bpmn:outgoing>P10_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P10_yes" name="Emitir informe con alcance">
      <bpmn:incoming>P10_f3</bpmn:incoming>
      <bpmn:outgoing>P10_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P10_no" name="Registrar anomalía o resultado no concluyente">
      <bpmn:incoming>P10_f4</bpmn:incoming>
      <bpmn:outgoing>P10_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P10_ey" name="Informe emitido">
      <bpmn:incoming>P10_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P10_en" name="Investigación requerida">
      <bpmn:incoming>P10_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P10_f0" sourceRef="P10_start" targetRef="P10_t1" name="" />
    <bpmn:sequenceFlow id="P10_f1" sourceRef="P10_t1" targetRef="P10_t2" name="" />
    <bpmn:sequenceFlow id="P10_f2" sourceRef="P10_t2" targetRef="P10_gate" name="" />
    <bpmn:sequenceFlow id="P10_f3" sourceRef="P10_gate" targetRef="P10_yes" name="Sí" />
    <bpmn:sequenceFlow id="P10_f4" sourceRef="P10_gate" targetRef="P10_no" name="No" />
    <bpmn:sequenceFlow id="P10_f5" sourceRef="P10_yes" targetRef="P10_ey" name="" />
    <bpmn:sequenceFlow id="P10_f6" sourceRef="P10_no" targetRef="P10_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P10_diagram">
    <bpmndi:BPMNPlane id="P10_plane" bpmnElement="P10_coll">
      <bpmndi:BPMNShape id="P10_pool_di" bpmnElement="P10_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_lane_di0" bpmnElement="P10_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_lane_di1" bpmnElement="P10_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_lane_di2" bpmnElement="P10_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P10_edge0" bpmnElement="P10_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge1" bpmnElement="P10_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="540.0" y="215.0" />
        <di:waypoint x="540.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge2" bpmnElement="P10_f2">
        <di:waypoint x="540.0" y="311.0" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge3" bpmnElement="P10_f3">
        <di:waypoint x="540.0" y="422.0" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge4" bpmnElement="P10_f4">
        <di:waypoint x="567.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="660.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge5" bpmnElement="P10_f5">
        <di:waypoint x="420.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="540.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_edge6" bpmnElement="P10_f6">
        <di:waypoint x="660.0" y="635.0" />
        <di:waypoint x="685.0" y="635.0" />
        <di:waypoint x="685.0" y="835.0" />
        <di:waypoint x="557.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P10_start_di" bpmnElement="P10_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_t1_di" bpmnElement="P10_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_t2_di" bpmnElement="P10_t2">
        <dc:Bounds x="420.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_gate_di" bpmnElement="P10_gate">
        <dc:Bounds x="513.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_yes_di" bpmnElement="P10_yes">
        <dc:Bounds x="420.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_no_di" bpmnElement="P10_no">
        <dc:Bounds x="420.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_ey_di" bpmnElement="P10_ey">
        <dc:Bounds x="523.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_en_di" bpmnElement="P10_en">
        <dc:Bounds x="523.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>