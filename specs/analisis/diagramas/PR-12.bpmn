<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P12_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P12_coll">
    <bpmn:participant id="P12_pool" name="PR-12 Política temporal" processRef="P12" />
  </bpmn:collaboration>
  <bpmn:process id="P12" isExecutable="false">
    <bpmn:laneSet id="P12_lanes">
      <bpmn:lane id="P12_lane0" name="Operador de recepción">
        <bpmn:flowNodeRef>P12_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_lane1" name="Responsable farmacéutico">
        <bpmn:flowNodeRef>P12_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_lane2" name="MedStock">
        <bpmn:flowNodeRef>P12_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_en</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P12_start" name="Inicio">
      <bpmn:outgoing>P12_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P12_t1" name="Capturar rótulo y precisión">
      <bpmn:incoming>P12_f0</bpmn:incoming>
      <bpmn:outgoing>P12_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P12_t2" name="Revisar interpretación aplicable">
      <bpmn:incoming>P12_f1</bpmn:incoming>
      <bpmn:outgoing>P12_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P12_gate" name="¿Política aprobada y fecha válida?">
      <bpmn:incoming>P12_f2</bpmn:incoming>
      <bpmn:outgoing>P12_f3</bpmn:outgoing>
      <bpmn:outgoing>P12_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P12_yes" name="Conservar interpretación y evaluar elegibilidad">
      <bpmn:incoming>P12_f3</bpmn:incoming>
      <bpmn:outgoing>P12_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P12_no" name="Retener para revisión sin habilitar despacho">
      <bpmn:incoming>P12_f4</bpmn:incoming>
      <bpmn:outgoing>P12_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P12_ey" name="Fecha interpretable">
      <bpmn:incoming>P12_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P12_en" name="Revisión pendiente">
      <bpmn:incoming>P12_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P12_f0" sourceRef="P12_start" targetRef="P12_t1" name="" />
    <bpmn:sequenceFlow id="P12_f1" sourceRef="P12_t1" targetRef="P12_t2" name="" />
    <bpmn:sequenceFlow id="P12_f2" sourceRef="P12_t2" targetRef="P12_gate" name="" />
    <bpmn:sequenceFlow id="P12_f3" sourceRef="P12_gate" targetRef="P12_yes" name="Sí" />
    <bpmn:sequenceFlow id="P12_f4" sourceRef="P12_gate" targetRef="P12_no" name="No" />
    <bpmn:sequenceFlow id="P12_f5" sourceRef="P12_yes" targetRef="P12_ey" name="" />
    <bpmn:sequenceFlow id="P12_f6" sourceRef="P12_no" targetRef="P12_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P12_diagram">
    <bpmndi:BPMNPlane id="P12_plane" bpmnElement="P12_coll">
      <bpmndi:BPMNShape id="P12_pool_di" bpmnElement="P12_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_di0" bpmnElement="P12_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_di1" bpmnElement="P12_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_di2" bpmnElement="P12_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P12_edge0" bpmnElement="P12_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge1" bpmnElement="P12_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="540.0" y="215.0" />
        <di:waypoint x="540.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge2" bpmnElement="P12_f2">
        <di:waypoint x="540.0" y="311.0" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge3" bpmnElement="P12_f3">
        <di:waypoint x="540.0" y="422.0" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="870.0" y="455.5" />
        <di:waypoint x="870.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge4" bpmnElement="P12_f4">
        <di:waypoint x="567.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="990.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge5" bpmnElement="P12_f5">
        <di:waypoint x="750.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="870.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_edge6" bpmnElement="P12_f6">
        <di:waypoint x="990.0" y="635.0" />
        <di:waypoint x="1015.0" y="635.0" />
        <di:waypoint x="1015.0" y="835.0" />
        <di:waypoint x="887.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P12_start_di" bpmnElement="P12_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_t1_di" bpmnElement="P12_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_t2_di" bpmnElement="P12_t2">
        <dc:Bounds x="420.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_gate_di" bpmnElement="P12_gate">
        <dc:Bounds x="513.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_yes_di" bpmnElement="P12_yes">
        <dc:Bounds x="750.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_no_di" bpmnElement="P12_no">
        <dc:Bounds x="750.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_ey_di" bpmnElement="P12_ey">
        <dc:Bounds x="853.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_en_di" bpmnElement="P12_en">
        <dc:Bounds x="853.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>