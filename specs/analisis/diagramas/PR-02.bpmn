<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P2_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P2_coll">
    <bpmn:participant id="P2_pool" name="PR-02 Recepción" processRef="P2" />
  </bpmn:collaboration>
  <bpmn:process id="P2" isExecutable="false">
    <bpmn:laneSet id="P2_lanes">
      <bpmn:lane id="P2_lane0" name="Almacenero">
        <bpmn:flowNodeRef>P2_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_lane1" name="Responsable farmacéutico">
        <bpmn:flowNodeRef>P2_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_lane2" name="MedStock">
        <bpmn:flowNodeRef>P2_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_en</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_start" name="Inicio">
      <bpmn:outgoing>P2_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P2_t1" name="Capturar documento y lotes">
      <bpmn:incoming>P2_f0</bpmn:incoming>
      <bpmn:outgoing>P2_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_t2" name="Revisar condición física y datos">
      <bpmn:incoming>P2_f1</bpmn:incoming>
      <bpmn:outgoing>P2_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P2_gate" name="¿Conforme?">
      <bpmn:incoming>P2_f2</bpmn:incoming>
      <bpmn:outgoing>P2_f3</bpmn:outgoing>
      <bpmn:outgoing>P2_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P2_yes" name="Confirmar entrada utilizable y auditoría">
      <bpmn:incoming>P2_f3</bpmn:incoming>
      <bpmn:outgoing>P2_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P2_no" name="Registrar observado en cuarentena">
      <bpmn:incoming>P2_f4</bpmn:incoming>
      <bpmn:outgoing>P2_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P2_ey" name="Entrada confirmada">
      <bpmn:incoming>P2_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P2_en" name="Observado para evaluación">
      <bpmn:incoming>P2_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_f0" sourceRef="P2_start" targetRef="P2_t1" name="" />
    <bpmn:sequenceFlow id="P2_f1" sourceRef="P2_t1" targetRef="P2_t2" name="" />
    <bpmn:sequenceFlow id="P2_f2" sourceRef="P2_t2" targetRef="P2_gate" name="" />
    <bpmn:sequenceFlow id="P2_f3" sourceRef="P2_gate" targetRef="P2_yes" name="Sí" />
    <bpmn:sequenceFlow id="P2_f4" sourceRef="P2_gate" targetRef="P2_no" name="No" />
    <bpmn:sequenceFlow id="P2_f5" sourceRef="P2_yes" targetRef="P2_ey" name="" />
    <bpmn:sequenceFlow id="P2_f6" sourceRef="P2_no" targetRef="P2_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P2_diagram">
    <bpmndi:BPMNPlane id="P2_plane" bpmnElement="P2_coll">
      <bpmndi:BPMNShape id="P2_pool_di" bpmnElement="P2_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_lane_di0" bpmnElement="P2_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_lane_di1" bpmnElement="P2_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_lane_di2" bpmnElement="P2_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P2_edge0" bpmnElement="P2_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge1" bpmnElement="P2_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="540.0" y="215.0" />
        <di:waypoint x="540.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge2" bpmnElement="P2_f2">
        <di:waypoint x="540.0" y="311.0" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge3" bpmnElement="P2_f3">
        <di:waypoint x="540.0" y="422.0" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="870.0" y="455.5" />
        <di:waypoint x="870.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge4" bpmnElement="P2_f4">
        <di:waypoint x="567.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="990.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge5" bpmnElement="P2_f5">
        <di:waypoint x="750.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="870.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_edge6" bpmnElement="P2_f6">
        <di:waypoint x="990.0" y="635.0" />
        <di:waypoint x="1015.0" y="635.0" />
        <di:waypoint x="1015.0" y="835.0" />
        <di:waypoint x="887.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P2_start_di" bpmnElement="P2_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_t1_di" bpmnElement="P2_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_t2_di" bpmnElement="P2_t2">
        <dc:Bounds x="420.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_gate_di" bpmnElement="P2_gate">
        <dc:Bounds x="513.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_yes_di" bpmnElement="P2_yes">
        <dc:Bounds x="750.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_no_di" bpmnElement="P2_no">
        <dc:Bounds x="750.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_ey_di" bpmnElement="P2_ey">
        <dc:Bounds x="853.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_en_di" bpmnElement="P2_en">
        <dc:Bounds x="853.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>