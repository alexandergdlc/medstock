<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P5_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P5_coll">
    <bpmn:participant id="P5_pool" name="PR-05 Despacho" processRef="P5" />
  </bpmn:collaboration>
  <bpmn:process id="P5" isExecutable="false">
    <bpmn:laneSet id="P5_lanes">
      <bpmn:lane id="P5_lane0" name="Farmacia">
        <bpmn:flowNodeRef>P5_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_lane1" name="MedStock">
        <bpmn:flowNodeRef>P5_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_en</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_lane2" name="Responsable de servicio" />
    </bpmn:laneSet>
    <bpmn:startEvent id="P5_start" name="Inicio">
      <bpmn:outgoing>P5_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P5_t1" name="Revisar autorización y aceptación parcial">
      <bpmn:incoming>P5_f0</bpmn:incoming>
      <bpmn:outgoing>P5_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_t2" name="Revalidar FEFO o reserva y pendiente">
      <bpmn:incoming>P5_f1</bpmn:incoming>
      <bpmn:outgoing>P5_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P5_gate" name="¿Confirmación válida?">
      <bpmn:incoming>P5_f2</bpmn:incoming>
      <bpmn:outgoing>P5_f3</bpmn:outgoing>
      <bpmn:outgoing>P5_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P5_yes" name="Confirmar salida y actualizar remanente">
      <bpmn:incoming>P5_f3</bpmn:incoming>
      <bpmn:outgoing>P5_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P5_no" name="Informar rechazo sin movimiento">
      <bpmn:incoming>P5_f4</bpmn:incoming>
      <bpmn:outgoing>P5_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P5_ey" name="Constancia disponible">
      <bpmn:incoming>P5_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P5_en" name="Seguimiento requerido">
      <bpmn:incoming>P5_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P5_f0" sourceRef="P5_start" targetRef="P5_t1" name="" />
    <bpmn:sequenceFlow id="P5_f1" sourceRef="P5_t1" targetRef="P5_t2" name="" />
    <bpmn:sequenceFlow id="P5_f2" sourceRef="P5_t2" targetRef="P5_gate" name="" />
    <bpmn:sequenceFlow id="P5_f3" sourceRef="P5_gate" targetRef="P5_yes" name="Sí" />
    <bpmn:sequenceFlow id="P5_f4" sourceRef="P5_gate" targetRef="P5_no" name="No" />
    <bpmn:sequenceFlow id="P5_f5" sourceRef="P5_yes" targetRef="P5_ey" name="" />
    <bpmn:sequenceFlow id="P5_f6" sourceRef="P5_no" targetRef="P5_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P5_diagram">
    <bpmndi:BPMNPlane id="P5_plane" bpmnElement="P5_coll">
      <bpmndi:BPMNShape id="P5_pool_di" bpmnElement="P5_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_lane_di0" bpmnElement="P5_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_lane_di1" bpmnElement="P5_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_lane_di2" bpmnElement="P5_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P5_edge0" bpmnElement="P5_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge1" bpmnElement="P5_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="540.0" y="215.0" />
        <di:waypoint x="540.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge2" bpmnElement="P5_f2">
        <di:waypoint x="540.0" y="311.0" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge3" bpmnElement="P5_f3">
        <di:waypoint x="540.0" y="422.0" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge4" bpmnElement="P5_f4">
        <di:waypoint x="567.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="660.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge5" bpmnElement="P5_f5">
        <di:waypoint x="420.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="540.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_edge6" bpmnElement="P5_f6">
        <di:waypoint x="660.0" y="635.0" />
        <di:waypoint x="685.0" y="635.0" />
        <di:waypoint x="685.0" y="835.0" />
        <di:waypoint x="557.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P5_start_di" bpmnElement="P5_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t1_di" bpmnElement="P5_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t2_di" bpmnElement="P5_t2">
        <dc:Bounds x="420.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_gate_di" bpmnElement="P5_gate">
        <dc:Bounds x="513.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_yes_di" bpmnElement="P5_yes">
        <dc:Bounds x="420.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_no_di" bpmnElement="P5_no">
        <dc:Bounds x="420.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_ey_di" bpmnElement="P5_ey">
        <dc:Bounds x="523.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_en_di" bpmnElement="P5_en">
        <dc:Bounds x="523.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>