<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P6_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P6_coll">
    <bpmn:participant id="P6_pool" name="PR-06 Traslado" processRef="P6" />
  </bpmn:collaboration>
  <bpmn:process id="P6" isExecutable="false">
    <bpmn:laneSet id="P6_lanes">
      <bpmn:lane id="P6_lane0" name="Responsable de origen">
        <bpmn:flowNodeRef>P6_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_lane1" name="Operador de origen" />
      <bpmn:lane id="P6_lane2" name="Receptor de destino">
        <bpmn:flowNodeRef>P6_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_en</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P6_start" name="Inicio">
      <bpmn:outgoing>P6_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P6_t1" name="Autorizar y expedir lotes a tránsito">
      <bpmn:incoming>P6_f0</bpmn:incoming>
      <bpmn:outgoing>P6_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P6_t2" name="Contar recibidos y revisar condición">
      <bpmn:incoming>P6_f1</bpmn:incoming>
      <bpmn:outgoing>P6_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P6_gate" name="¿Recepción completa conforme?">
      <bpmn:incoming>P6_f2</bpmn:incoming>
      <bpmn:outgoing>P6_f3</bpmn:outgoing>
      <bpmn:outgoing>P6_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P6_yes" name="Confirmar recepción y cerrar conciliado">
      <bpmn:incoming>P6_f3</bpmn:incoming>
      <bpmn:outgoing>P6_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P6_no" name="Registrar parcial o daño y resolver diferencia">
      <bpmn:incoming>P6_f4</bpmn:incoming>
      <bpmn:outgoing>P6_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P6_ey" name="Traslado cerrado">
      <bpmn:incoming>P6_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P6_en" name="Diferencia pendiente">
      <bpmn:incoming>P6_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P6_f0" sourceRef="P6_start" targetRef="P6_t1" name="" />
    <bpmn:sequenceFlow id="P6_f1" sourceRef="P6_t1" targetRef="P6_t2" name="" />
    <bpmn:sequenceFlow id="P6_f2" sourceRef="P6_t2" targetRef="P6_gate" name="" />
    <bpmn:sequenceFlow id="P6_f3" sourceRef="P6_gate" targetRef="P6_yes" name="Sí" />
    <bpmn:sequenceFlow id="P6_f4" sourceRef="P6_gate" targetRef="P6_no" name="No" />
    <bpmn:sequenceFlow id="P6_f5" sourceRef="P6_yes" targetRef="P6_ey" name="" />
    <bpmn:sequenceFlow id="P6_f6" sourceRef="P6_no" targetRef="P6_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P6_diagram">
    <bpmndi:BPMNPlane id="P6_plane" bpmnElement="P6_coll">
      <bpmndi:BPMNShape id="P6_pool_di" bpmnElement="P6_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_lane_di0" bpmnElement="P6_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_lane_di1" bpmnElement="P6_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_lane_di2" bpmnElement="P6_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P6_edge0" bpmnElement="P6_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge1" bpmnElement="P6_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="870.0" y="215.0" />
        <di:waypoint x="870.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge2" bpmnElement="P6_f2">
        <di:waypoint x="870.0" y="311.0" />
        <di:waypoint x="870.0" y="339.5" />
        <di:waypoint x="870.0" y="339.5" />
        <di:waypoint x="870.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge3" bpmnElement="P6_f3">
        <di:waypoint x="870.0" y="422.0" />
        <di:waypoint x="870.0" y="455.5" />
        <di:waypoint x="870.0" y="455.5" />
        <di:waypoint x="870.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge4" bpmnElement="P6_f4">
        <di:waypoint x="897.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="990.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge5" bpmnElement="P6_f5">
        <di:waypoint x="750.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="870.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P6_edge6" bpmnElement="P6_f6">
        <di:waypoint x="990.0" y="635.0" />
        <di:waypoint x="1015.0" y="635.0" />
        <di:waypoint x="1015.0" y="835.0" />
        <di:waypoint x="887.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P6_start_di" bpmnElement="P6_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_t1_di" bpmnElement="P6_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_t2_di" bpmnElement="P6_t2">
        <dc:Bounds x="750.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_gate_di" bpmnElement="P6_gate">
        <dc:Bounds x="843.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_yes_di" bpmnElement="P6_yes">
        <dc:Bounds x="750.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_no_di" bpmnElement="P6_no">
        <dc:Bounds x="750.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_ey_di" bpmnElement="P6_ey">
        <dc:Bounds x="853.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P6_en_di" bpmnElement="P6_en">
        <dc:Bounds x="853.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>