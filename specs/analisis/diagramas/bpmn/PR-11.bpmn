<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P11_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P11_coll">
    <bpmn:participant id="P11_pool" name="PR-11 Reserva" processRef="P11" />
  </bpmn:collaboration>
  <bpmn:process id="P11" isExecutable="false">
    <bpmn:laneSet id="P11_lanes">
      <bpmn:lane id="P11_lane0" name="Farmacia">
        <bpmn:flowNodeRef>P11_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane1" name="MedStock">
        <bpmn:flowNodeRef>P11_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_en</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane2" name="Responsable de servicio" />
    </bpmn:laneSet>
    <bpmn:startEvent id="P11_start" name="Inicio">
      <bpmn:outgoing>P11_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P11_t1" name="Solicitar reserva sobre demanda autorizada">
      <bpmn:incoming>P11_f0</bpmn:incoming>
      <bpmn:outgoing>P11_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P11_t2" name="Revalidar saldo lote y fin temporal">
      <bpmn:incoming>P11_f1</bpmn:incoming>
      <bpmn:outgoing>P11_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P11_gate" name="¿Se puede comprometer?">
      <bpmn:incoming>P11_f2</bpmn:incoming>
      <bpmn:outgoing>P11_f3</bpmn:outgoing>
      <bpmn:outgoing>P11_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P11_yes" name="Registrar reserva sin cambiar físico">
      <bpmn:incoming>P11_f3</bpmn:incoming>
      <bpmn:outgoing>P11_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P11_no" name="Informar causa y conservar demanda">
      <bpmn:incoming>P11_f4</bpmn:incoming>
      <bpmn:outgoing>P11_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P11_ey" name="Reserva activa">
      <bpmn:incoming>P11_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P11_en" name="Sin compromiso nuevo">
      <bpmn:incoming>P11_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P11_f0" sourceRef="P11_start" targetRef="P11_t1" name="" />
    <bpmn:sequenceFlow id="P11_f1" sourceRef="P11_t1" targetRef="P11_t2" name="" />
    <bpmn:sequenceFlow id="P11_f2" sourceRef="P11_t2" targetRef="P11_gate" name="" />
    <bpmn:sequenceFlow id="P11_f3" sourceRef="P11_gate" targetRef="P11_yes" name="Sí" />
    <bpmn:sequenceFlow id="P11_f4" sourceRef="P11_gate" targetRef="P11_no" name="No" />
    <bpmn:sequenceFlow id="P11_f5" sourceRef="P11_yes" targetRef="P11_ey" name="" />
    <bpmn:sequenceFlow id="P11_f6" sourceRef="P11_no" targetRef="P11_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P11_diagram">
    <bpmndi:BPMNPlane id="P11_plane" bpmnElement="P11_coll">
      <bpmndi:BPMNShape id="P11_pool_di" bpmnElement="P11_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_di0" bpmnElement="P11_lane0" isHorizontal="false">
        <dc:Bounds x="45" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_di1" bpmnElement="P11_lane1" isHorizontal="false">
        <dc:Bounds x="375" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_di2" bpmnElement="P11_lane2" isHorizontal="false">
        <dc:Bounds x="705" y="30" width="330" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P11_edge0" bpmnElement="P11_f0">
        <di:waypoint x="210.0" y="87.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="103.0" />
        <di:waypoint x="210.0" y="119.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge1" bpmnElement="P11_f1">
        <di:waypoint x="210.0" y="191.0" />
        <di:waypoint x="210.0" y="215.0" />
        <di:waypoint x="540.0" y="215.0" />
        <di:waypoint x="540.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge2" bpmnElement="P11_f2">
        <di:waypoint x="540.0" y="311.0" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="339.5" />
        <di:waypoint x="540.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge3" bpmnElement="P11_f3">
        <di:waypoint x="540.0" y="422.0" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge4" bpmnElement="P11_f4">
        <di:waypoint x="567.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="660.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge5" bpmnElement="P11_f5">
        <di:waypoint x="420.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="540.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_edge6" bpmnElement="P11_f6">
        <di:waypoint x="660.0" y="635.0" />
        <di:waypoint x="685.0" y="635.0" />
        <di:waypoint x="685.0" y="835.0" />
        <di:waypoint x="557.0" y="835.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P11_start_di" bpmnElement="P11_start">
        <dc:Bounds x="193.0" y="53.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_t1_di" bpmnElement="P11_t1">
        <dc:Bounds x="90.0" y="119.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_t2_di" bpmnElement="P11_t2">
        <dc:Bounds x="420.0" y="239.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_gate_di" bpmnElement="P11_gate">
        <dc:Bounds x="513.0" y="368.0" width="54" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_yes_di" bpmnElement="P11_yes">
        <dc:Bounds x="420.0" y="489.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_no_di" bpmnElement="P11_no">
        <dc:Bounds x="420.0" y="599.0" width="240" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_ey_di" bpmnElement="P11_ey">
        <dc:Bounds x="523.0" y="718.0" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_en_di" bpmnElement="P11_en">
        <dc:Bounds x="523.0" y="818.0" width="34" height="34" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>