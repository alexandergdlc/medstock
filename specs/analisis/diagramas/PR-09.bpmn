<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P9_defs" targetNamespace="https://medstock.example/analysis">
  <bpmn:collaboration id="P9_coll">
    <bpmn:participant id="P9_pool" name="PR-09 Bloqueo retiro y baja" processRef="P9" />
  </bpmn:collaboration>
  <bpmn:process id="P9" isExecutable="false">
    <bpmn:laneSet id="P9_lanes">
      <bpmn:lane id="P9_lane0" name="Responsable farmacéutico">
        <bpmn:flowNodeRef>P9_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P9_lane1" name="Operador de custodia">
        <bpmn:flowNodeRef>P9_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_ey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_en</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P9_lane2" name="MedStock">
        <bpmn:flowNodeRef>P9_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P9_start" name="Inicio">
      <bpmn:outgoing>P9_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P9_t1" name="Identificar lote y bloquear alcance">
      <bpmn:incoming>P9_f0</bpmn:incoming>
      <bpmn:outgoing>P9_f1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P9_t2" name="Localizar saldos tránsito y salidas">
      <bpmn:incoming>P9_f1</bpmn:incoming>
      <bpmn:outgoing>P9_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P9_gate" name="¿Corresponde baja autorizada?">
      <bpmn:incoming>P9_f2</bpmn:incoming>
      <bpmn:outgoing>P9_f3</bpmn:outgoing>
      <bpmn:outgoing>P9_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P9_yes" name="Registrar salida de segregado y evidencia">
      <bpmn:incoming>P9_f3</bpmn:incoming>
      <bpmn:outgoing>P9_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P9_no" name="Mantener bloqueo y seguimiento">
      <bpmn:incoming>P9_f4</bpmn:incoming>
      <bpmn:outgoing>P9_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P9_ey" name="Baja registrada">
      <bpmn:incoming>P9_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P9_en" name="Seguimiento abierto">
      <bpmn:incoming>P9_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P9_f0" sourceRef="P9_start" targetRef="P9_t1" name="" />
    <bpmn:sequenceFlow id="P9_f1" sourceRef="P9_t1" targetRef="P9_t2" name="" />
    <bpmn:sequenceFlow id="P9_f2" sourceRef="P9_t2" targetRef="P9_gate" name="" />
    <bpmn:sequenceFlow id="P9_f3" sourceRef="P9_gate" targetRef="P9_yes" name="Sí" />
    <bpmn:sequenceFlow id="P9_f4" sourceRef="P9_gate" targetRef="P9_no" name="No" />
    <bpmn:sequenceFlow id="P9_f5" sourceRef="P9_yes" targetRef="P9_ey" name="" />
    <bpmn:sequenceFlow id="P9_f6" sourceRef="P9_no" targetRef="P9_en" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P9_diagram">
    <bpmndi:BPMNPlane id="P9_plane" bpmnElement="P9_coll">
      <bpmndi:BPMNShape id="P9_pool_di" bpmnElement="P9_pool" isHorizontal="false">
        <dc:Bounds x="35" y="0" width="1030" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P9_lane_di0" bpmnElement="P9_lane0" isHorizontal="false">
