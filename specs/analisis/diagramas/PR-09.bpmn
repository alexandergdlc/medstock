        <di:waypoint x="870.0" y="215.0" />
        <di:waypoint x="870.0" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P9_edge2" bpmnElement="P9_f2">
        <di:waypoint x="870.0" y="311.0" />
        <di:waypoint x="870.0" y="339.5" />
        <di:waypoint x="210.0" y="339.5" />
        <di:waypoint x="210.0" y="368.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P9_edge3" bpmnElement="P9_f3">
        <di:waypoint x="210.0" y="422.0" />
        <di:waypoint x="210.0" y="455.5" />
        <di:waypoint x="540.0" y="455.5" />
        <di:waypoint x="540.0" y="489.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P9_edge4" bpmnElement="P9_f4">
        <di:waypoint x="237.0" y="395.0" />
        <di:waypoint x="1035" y="395.0" />
        <di:waypoint x="1035" y="635.0" />
        <di:waypoint x="660.0" y="635.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P9_edge5" bpmnElement="P9_f5">
        <di:waypoint x="420.0" y="525.0" />
        <di:waypoint x="65" y="525.0" />
        <di:waypoint x="65" y="718.0" />
        <di:waypoint x="540.0" y="718.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P9_edge6" bpmnElement="P9_f6">
        <di:waypoint x="660.0" y="635.0" />
        <di:waypoint x="685.0" y="635.0" />
        <di:waypoint x="685.0" y="835.0" />
